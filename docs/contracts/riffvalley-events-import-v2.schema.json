{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Riff Valley scraped events import v2",
  "description": "Portable input contract consumed by the frontend scraper JSON importer. Version 2 adds Tour rows while version 1 remains supported.",
  "type": "object",
  "required": ["format", "version", "source", "country", "events"],
  "properties": {
    "format": { "const": "riffvalley.events-import" },
    "version": { "const": 2 },
    "source": { "$ref": "#/$defs/source" },
    "country": { "$ref": "#/$defs/nonBlankText" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonBlankText": {
      "type": "string",
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonBlankText" }
      },
      "additionalProperties": true
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "artistName": { "$ref": "#/$defs/nonBlankText" },
    "event": {
      "type": "object",
      "required": ["type", "startDate", "artists", "locality"],
      "properties": {
        "type": { "enum": ["concert", "festival", "tour"] },
        "title": {
          "$ref": "#/$defs/nonBlankText",
          "description": "For type tour, this is the tour name resolved by the existing Tour resolver."
        },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "artists": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artistName" }
        },
        "venue": { "$ref": "#/$defs/nonBlankText" },
        "locality": { "$ref": "#/$defs/nonBlankText" },
        "province": {
          "$ref": "#/$defs/nonBlankText",
          "description": "Textual locality-resolution hint; distinct from administrative region."
        },
        "region": { "$ref": "#/$defs/nonBlankText" },
        "country": { "$ref": "#/$defs/nonBlankText" },
        "price": { "type": "string" },
        "additionalInfo": { "type": "string" },
        "url": { "type": "string" },
        "externalId": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "enum": ["festival", "tour"] } },
            "required": ["type"]
          },
          "then": { "required": ["title"] }
        }
      ],
      "additionalProperties": true
    }
  }
}
